	measure '대표 댓글 1' = ```
				IF(
				    NOT (HASONEVALUE('연결'[표시대상]) && HASONEVALUE('연결'[매력])),
				    "캐릭터 또는 영역을 고르고, 매력 막대를 선택하세요",
				    VAR body = CALCULATE(MAX('연결'[댓글발췌]), '연결'[카드순] = 1)
				    VAR note = CALCULATE(MAX('연결'[매력]) & " · " & MAX('연결'[호감근거_수준]) & " · " & MAX('연결'[발췌표시]), '연결'[카드순] = 1)
				    RETURN IF(ISBLANK(body), "이 순위에는 댓글이 없습니다", note & " | " & body)
				)
			```
		formatString: @
		displayFolder: 연결
		lineageTag: d22aeb81-e17f-4340-bfb3-564e19531d67

