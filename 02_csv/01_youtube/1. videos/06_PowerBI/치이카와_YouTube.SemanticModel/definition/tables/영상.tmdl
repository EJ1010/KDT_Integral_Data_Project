table 영상
	lineageTag: 49e2a2bd-c522-40c9-8427-1fb394512a76

	measure '영상 수' = DISTINCTCOUNT('영상'[post_id])
		formatString: #,0
		displayFolder: 영상
		lineageTag: 15e588b3-3bf8-4db6-b4c1-82fa7c383de4

	measure '채널 수' = ```
				CALCULATE(
				    DISTINCTCOUNT('영상'[account_id]),
				    '영상'[account_id] <> ""
				)
			```
		formatString: #,0
		displayFolder: 영상
		lineageTag: f7a98d31-645a-4411-b64d-78269814a329

	measure '관측 누적조회수' = SUM('영상'[조회수])
		formatString: #,0
		displayFolder: 영상
		lineageTag: 34245f48-2781-428c-9a11-5ca3f7a12df8

	measure '조회수 중앙값' = MEDIAN('영상'[조회수])
		formatString: #,0
		displayFolder: 영상
		lineageTag: e1c82d19-04ca-4d47-a3f5-26b8202b0a16

	measure '조회수 유효 영상 수' = COUNT('영상'[조회수])
		formatString: #,0
		displayFolder: 영상
		lineageTag: af5d24aa-c731-4de1-8bd9-e98ce049d903

	measure '길이 비중' = ```
				DIVIDE(
				    [영상 수],
				    CALCULATE([영상 수], REMOVEFILTERS('영상'[길이구간], '영상'[길이순서]))
				)
			```
		formatString: 0.0%
		displayFolder: 영상
		lineageTag: 879da370-dd76-43dd-adc2-9557fa4ab2cd

	measure '조회수 표시' = ```
				FORMAT(
				    DIVIDE([관측 누적조회수], 100000000),
				    "0.00"
				) & "억 회"
			```
		formatString: @
		displayFolder: 영상
		lineageTag: bb1672f1-75e5-4863-b9aa-97f1527a5f8b

